{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "typegen": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "typegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types", "typegen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      // wrangler.jsonc の assets が ../web/dist を配信するため、
      // Workerをデプロイする前に必ずフロントのビルドを終わらせる必要がある。
      "dependsOn": ["web#build"],
      "cache": false,
    }
  }
}
