{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "typegen": {
      "cache": false
    },
    "build": {
      "env": ["VITE_API_URL"],
      "dependsOn": ["^build", "typegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types", "typegen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
